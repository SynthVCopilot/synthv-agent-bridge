{
  "name": "synthv-agent-bridge",
  "version": "0.1.3",
  "description": "A reliable MCP bridge for controlling Synthesizer V Studio through its scripting API.",
  "private": true,
  "type": "module",
  "bin": {
    "synthv-agent-bridge": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "synthv",
    "scripts",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test",
    "start": "node dist/src/cli.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/src/cli.js",
    "install:synthv": "node scripts/install-synthv-bridge.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.12"
    }
  },
  "keywords": [
    "synthesizer-v",
    "synthv",
    "mcp",
    "model-context-protocol",
    "music",
    "vocal-synthesis"
  ],
  "license": "Apache-2.0"
}
