# Optional. The MCP process and Synthesizer V Studio must resolve the same directory.
# On Windows, prefer a native Windows path when both processes run on Windows.
# SYNTHV_AGENT_BRIDGE_DIR=C:\Users\you\AppData\Local\Temp

# Milliseconds before a tool call fails if the SynthV bridge does not reply.
SYNTHV_AGENT_BRIDGE_TIMEOUT_MS=15000

# MCP-side response polling interval in milliseconds.
SYNTHV_AGENT_BRIDGE_POLL_MS=50

# Age after which an abandoned IPC request or lock may be recovered.
# This value must be greater than SYNTHV_AGENT_BRIDGE_TIMEOUT_MS.
SYNTHV_AGENT_BRIDGE_STALE_REQUEST_MS=30000

# Maximum heartbeat age considered connected.
SYNTHV_AGENT_BRIDGE_STATUS_STALE_MS=5000
